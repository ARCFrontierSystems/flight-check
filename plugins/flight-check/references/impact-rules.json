{
  "description": "Which audit domains a changed file can affect, by path pattern (fnmatch on the relative path and on the file name). A changed file that matches no rule and that no stored conclusion cites widens reassessment to every applicable domain. Order does not matter: all matching rules apply.",
  "rules": [
    {"name": "dependency manifests and lockfiles",
     "patterns": ["package.json", "*lock.json", "*.lock", "yarn.lock", "pnpm-lock.yaml", "requirements*.txt", "pyproject.toml", "Pipfile*", "poetry.lock", "go.mod", "go.sum", "Cargo.toml", "Cargo.lock", "Gemfile*", "composer.json", "composer.lock", "pom.xml", "build.gradle*", "*.csproj", "packages.config", "Package.swift", "Package.resolved", "pubspec.yaml", "pubspec.lock", "mix.exs", "mix.lock"],
     "domains": ["supply-chain", "third-party", "ip-assets"]},
    {"name": "CI, containers, and infrastructure",
     "patterns": [".github/*", ".gitlab-ci.yml", ".circleci/*", "Jenkinsfile", "Dockerfile*", "*.dockerfile", "docker-compose*", "compose*.yml", "compose*.yaml", "*.tf", "*.tfvars", "k8s/*", "kubernetes/*", "helm/*", "deploy/*", "infra/*", "Procfile", "fly.toml", "vercel.json", "netlify.toml", "render.yaml", "app.yaml", "serverless.yml", "*.Caddyfile", "Caddyfile", "nginx*.conf", "crontab", "*.service"],
     "domains": ["infrastructure", "reliability", "operational-readiness", "production-readiness", "supply-chain", "application-security"]},
    {"name": "environment and configuration",
     "patterns": [".env*", "*.env", "config/*", "*config.*", "settings.*", "*.ini", "*.toml", "*.yaml", "*.yml"],
     "domains": ["infrastructure", "application-security", "data-protection", "production-readiness"]},
    {"name": "user interface",
     "patterns": ["*.html", "*.htm", "*.css", "*.scss", "*.sass", "*.less", "*.jsx", "*.tsx", "*.vue", "*.svelte", "*.erb", "*.ejs", "*.hbs", "*.jinja", "*.j2", "*.twig", "*.cshtml", "templates/*", "views/*", "components/*", "static/*", "public/*"],
     "domains": ["accessibility", "application-security", "documentation"]},
    {"name": "data model and migrations",
     "patterns": ["*migrations/*", "*migrate*", "*.sql", "schema.*", "*schema*", "prisma/*", "models/*", "*model*"],
     "domains": ["data-protection", "privacy", "authorization", "reliability"]},
    {"name": "documentation and policies",
     "patterns": ["*.md", "*.rst", "*.txt", "docs/*", "*privacy*", "*terms*", "*legal*", "*license*", "LICENSE*", "NOTICE*", "*cookie*", "*refund*", "*accessibility*", "*security*"],
     "domains": ["documentation", "legal-business", "compliance-readiness", "privacy", "ip-assets"]},
    {"name": "tests",
     "patterns": ["tests/*", "test/*", "spec/*", "__tests__/*", "*_test.*", "*.test.*", "*.spec.*", "test_*", "*_spec.*"],
     "domains": ["testing"]},
    {"name": "authentication and sessions",
     "patterns": ["*auth*", "*login*", "*session*", "*password*", "*token*", "*oauth*", "*sso*", "*middleware*"],
     "domains": ["authentication", "authorization", "application-security", "data-protection"]},
    {"name": "payments",
     "patterns": ["*payment*", "*billing*", "*checkout*", "*subscription*", "*invoice*", "*webhook*", "*stripe*", "*paypal*", "*pricing*", "*refund*"],
     "domains": ["payments", "application-security", "legal-business", "reliability"]},
    {"name": "AI and model integrations",
     "patterns": ["*llm*", "*openai*", "*anthropic*", "*prompt*", "*embedding*", "*model_client*", "*triage*", "ai/*"],
     "domains": ["ai-llm", "privacy", "data-protection", "third-party"]},
    {"name": "assets",
     "patterns": ["*.svg", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ttf", "*.otf", "*.woff", "*.woff2", "*.mp3", "*.mp4", "fonts/*", "images/*", "img/*", "assets/*"],
     "domains": ["ip-assets", "accessibility"]}
  ],
  "source_code_domains": ["application-security", "authentication", "authorization", "data-protection", "privacy"],
  "source_code_domains_note": "A source file can change how requests are authenticated and authorized and how personal data is handled, wherever it lives, so a source change always reassesses these domains (when applicable), in addition to any rule above.",
  "source_code_suffixes": [".py", ".js", ".mjs", ".cjs", ".ts", ".go", ".rb", ".java", ".kt", ".php", ".cs", ".rs", ".swift", ".scala", ".ex", ".exs", ".c", ".cc", ".cpp", ".h", ".m", ".dart", ".lua", ".pl", ".sh"]
}
